# Nudge — backend configuration.
# Copy to .env and fill in. Never commit the real .env.

# Required by src/server/index.js for the AI savings insight.
# Without it, GET /api/savings/analysis still returns the computed figures
# but the `insight` string will fail to generate.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
